# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Server
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/deeepsleep_student_management?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=
DB_PASSWORD=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# Multipart upload
MAX_FILE_SIZE=7MB
MAX_REQUEST_SIZE=15MB

# AI service
AI_API_KEY=
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=4096

# Verification code
INTERVAL_LOCK_EXPIRE_SECONDS=60
CODE_EXPIRE_SECONDS=300
MAX_FAIL_NUMBER=5
TARGET_HASH_SECRET=

# JWT
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

# Aliyun OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=cn-hongkong
OSS_ENDPOINT=
OSS_BUCKET=
PRESIGNED_URL_EXPIRE_SECONDS=3600

# Aliyun SMS
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
